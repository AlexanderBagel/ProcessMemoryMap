#define VER_MAJOR 1
#define VER_MINOR 7
#define VER_RELEASE 54
#ifndef VER_BUILD
    #define VER_BUILD 0
#endif

#define Q(x) #x
#define QUOTE(x) Q(x)

#define VER_FILEVERSION             VER_MAJOR,VER_MINOR,VER_RELEASE,VER_BUILD
#define VER_PRODUCTVERSION          VER_MAJOR,VER_MINOR
#define VER_FILEVERSION_STR         QUOTE(VER_MAJOR.VER_MINOR.VER_RELEASE.VER_BUILD) "\0"
#define VER_PRODUCTVERSION_STR      QUOTE(VER_MAJOR.VER_MINOR) "\0"

1 VERSIONINFO
FILEVERSION    	VER_FILEVERSION
PRODUCTVERSION 	VER_PRODUCTVERSION

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription",  "Tool for examining process memory\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "pmm.exe\0"
            VALUE "LegalCopyright",   "© Alexander (Rouse_) Bagel\0"
            VALUE "OriginalFilename", "ProcessMM.exe\0"
            VALUE "ProductName",      "Process Memory Map\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        /* The following line should only be modified for localized versions.     */
        /* It consists of any number of WORD,WORD pairs, with each pair           */
        /* describing a language,codepage combination supported by the file.      */
        /*                                                                        */
        /* For example, a file might have values "0x409,1252" indicating that it  */
        /* supports English language (0x409) in the Windows ANSI codepage (1252). */

        VALUE "Translation", 0x409, 1252

    END
END


